<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KGMaster</AssemblyName>
    <RootNamespace>MusicCat.CLVKM.UI</RootNamespace>
    <Product>KeyGlowMaster by MusicCat161</Product>
    <AssemblyTitle>KeyGlowMaster by MusicCat161</AssemblyTitle>
    <Company>MusicCat161</Company>
    <Authors>acerhizm</Authors>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.5.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
    <None Update="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicCat.CLVKM.Core\MusicCat.CLVKM.Core.csproj" />
    <ProjectReference Include="..\MusicCat.CLVKM.Drivers\MusicCat.CLVKM.Drivers.csproj" />
  </ItemGroup>





</Project>
