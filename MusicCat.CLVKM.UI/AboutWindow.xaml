<Window x:Class="MusicCat.CLVKM.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MusicCat.CLVKM.UI"
        Title="KeyGlowMaster"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource DialogBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Margin="24">

            <!-- Header -->
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="{x:Static ui:Branding.IconImage}" Width="52" Height="52"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="KeyGlowMaster" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Click="Close_Click" Cursor="Hand" Width="30" Height="30"
                        VerticalAlignment="Top" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="{DynamicResource L_Close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,20,0,18"/>

            <!-- Credits -->
            <TextBlock Text="{DynamicResource About_Developer}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>

            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                <Run Text="{DynamicResource About_Based}"/><Run Text="&#160;"/><Hyperlink Click="Link_Click"
                          Foreground="{DynamicResource AccentBrush}" TextDecorations="None"><Run Text="{DynamicResource About_Link}"/></Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,16,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19">
                <Run Text="{DynamicResource About_Description}"/><Run Text=" "/><Run Text="{DynamicResource About_LicensePrefix}"/><Run Text="&#160;"/><Hyperlink Click="License_Click"
                          Foreground="{DynamicResource AccentBrush}" TextDecorations="None"><Run Text="{DynamicResource About_LicenseName}"/></Hyperlink><Run Text="."/>
            </TextBlock>

            <Button Content="{DynamicResource L_Close}" Click="Close_Click" Width="120" Height="34"
                    HorizontalAlignment="Right" Margin="0,22,0,0" Cursor="Hand"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Border>
</Window>
