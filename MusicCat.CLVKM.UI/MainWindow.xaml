<Window x:Class="MusicCat.CLVKM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MusicCat.CLVKM.UI.ViewModels"
        xmlns:local="clr-namespace:MusicCat.CLVKM.UI"
        Title="MusicCatRGB by MusicCat161"
        Width="1160" Height="830" MinWidth="1060" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontSize="14">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ============================ Title bar ============================ -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="{x:Static local:Branding.IconImage}" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="MusicCatRGB" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="by MusicCat161" Margin="8,0,0,0" FontSize="15"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">

                <Border Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2" Margin="0,0,10,0"
                        ToolTip="{DynamicResource L_Language}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="RU" Command="{Binding SetLanguageCommand}" CommandParameter="ru">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LangButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRussian}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleThemeCommand}"
                        ToolTip="{DynamicResource L_Theme}" Margin="0,0,4,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE706;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                        <Setter Property="Text" Value="&#xE708;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="CleanClick"
                        ToolTip="{DynamicResource L_ResetTip}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MinimizeClick"
                        ToolTip="{DynamicResource L_Minimize}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="MaximizeClick"
                        ToolTip="{DynamicResource L_Maximize}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="CloseClick"
                        ToolTip="{DynamicResource L_Close}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================ Content ============================ -->
        <Grid Grid.Row="1" Margin="20,6,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Left: preview + colour -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="{DynamicResource L_Preview}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StaticHexColor}" HorizontalAlignment="Right"
                                       FontSize="16" FontFamily="Consolas, Cascadia Mono"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </DockPanel>

                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0">
                            <Border Width="680" Height="250" CornerRadius="14" BorderThickness="1">
                                <!-- Fixed dark deck so the keys stay readable in both themes -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1C1C23" Offset="0"/>
                                        <GradientStop Color="#0B0B10" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding PreviewColor}"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <UniformGrid Rows="5" Columns="15" Margin="16">
                                        <UniformGrid.Resources>
                                            <Style TargetType="Border" BasedOn="{StaticResource KeyStyle}">
                                                <Setter Property="Background"
                                                        Value="{Binding DataContext.PreviewColorBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Style>
                                        </UniformGrid.Resources>
                                        <Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/>
                                        <Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/>
                                        <Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/>
                                        <Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/>
                                        <Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/><Border/>
                                    </UniformGrid>

                                </Grid>
                            </Border>
                        </Viewbox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,0,0">
                            <TextBlock Text="{Binding SelectedAnimation.Name}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedAnimation.Description}" FontSize="14" Margin="10,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Shortcut reminder, same size as the section label above -->
                        <TextBlock Grid.Row="3" Text="{DynamicResource L_HotkeysHint}" FontSize="15"
                                   Margin="2,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Colour editor -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14,16,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_ColorsForAnimation}" Style="{StaticResource SectionLabelStyle}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding SelectPrimaryColorCommand}"
                                    ToolTip="{DynamicResource L_EditPrimary}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ColorChipStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimaryActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                             Fill="{Binding PrimaryColorBrush}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_PrimaryColor}" FontSize="15"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HexColor}" FontSize="14" Margin="0,1,0,0"
                                                   FontFamily="Consolas, Cascadia Mono"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding SelectSecondaryColorCommand}"
                                    ToolTip="{DynamicResource L_EditSecondary}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ColorChipStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSecondaryActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                             Fill="{Binding SecondaryColorBrush}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_SecondColor}" FontSize="15"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SecondaryHexColor}" FontSize="14" Margin="0,1,0,0"
                                                   FontFamily="Consolas, Cascadia Mono"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>


                        <Button Command="{Binding SelectTertiaryColorCommand}" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ColorChipStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTertiaryColor}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTertiaryActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                         Fill="{Binding TertiaryColorBrush}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_ThirdColor}" FontSize="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TertiaryHexColor}" FontSize="14" Margin="0,1,0,0"
                                               FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Notification flash colour: the same sliders below edit it -->
                        <Button Command="{Binding SelectFlashColorCommand}" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ColorChipStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFlashColor}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFlashActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="20" Height="20" VerticalAlignment="Center"
                                         Fill="{Binding FlashColorBrush}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_FlashColor}" FontSize="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding NotificationFlashHexColor}" FontSize="14" Margin="0,1,0,0"
                                               FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" FontSize="14" FontWeight="SemiBold" Foreground="#FFFF6B6B" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ActiveRed}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ActiveRed}" HorizontalAlignment="Right" FontSize="14"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" FontSize="14" FontWeight="SemiBold" Foreground="#FF4ADE80" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ActiveGreen}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ActiveGreen}" HorizontalAlignment="Right" FontSize="14"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" FontSize="14" FontWeight="SemiBold" Foreground="#FF60CDFF" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ActiveBlue}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ActiveBlue}" HorizontalAlignment="Right" FontSize="14"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                                     Fill="{Binding StaticColorBrush}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource L_Color}" Style="{StaticResource ValueLabelStyle}"
                                       FontSize="15" Margin="8,0,10,0"/>
                            <TextBox x:Name="HexBox" Grid.Column="2" Text="{Binding StaticHexColor, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="HexBox_GotFocus"
                                     MaxLength="7" CharacterCasing="Upper" FontFamily="Consolas, Cascadia Mono"/>
                            <Button Grid.Column="3" Content="{DynamicResource L_Apply}" Command="{Binding ApplyColorCommand}"
                                    IsEnabled="{Binding IsReady}" Style="{StaticResource AccentButtonStyle}"
                                    Height="40" Padding="18,0" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Weather effect: city + API link + current readings (weather effect only) -->
                <Border Grid.Row="2" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Padding" Value="14,12,14,12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowWeatherPanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Weather}" Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource L_WeatherCity}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>

                            <TextBox x:Name="CityBox" Grid.Column="1"
                                     Text="{Binding WeatherCityInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="80" ToolTip="{DynamicResource L_WeatherHint}"
                                     PreviewKeyDown="CityBox_PreviewKeyDown"
                                     LostKeyboardFocus="CityBox_LostKeyboardFocus"/>
                        </Grid>

                        <!-- City suggestions: names can exist in several regions -->
                        <Popup x:Name="CityPopup" PlacementTarget="{Binding ElementName=CityBox}" Placement="Bottom"
                               IsOpen="{Binding IsCitySuggestionsOpen, Mode=TwoWay}" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               Width="{Binding ActualWidth, ElementName=CityBox}">
                            <Border Background="{DynamicResource DialogBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                                </Border.Effect>

                                <ListBox x:Name="CitySuggestionsList" ItemsSource="{Binding CitySuggestions}"
                                         SelectedItem="{Binding SelectedCitySuggestion, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" MaxHeight="230"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseLeftButtonUp="CitySuggestions_MouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <DockPanel Margin="0,10,0,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WeatherUpdatedText}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding WeatherStatusBrush}"/>
                            <TextBlock Text="{Binding WeatherStatusText}" FontSize="15"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WeatherErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WeatherErrorText}" Value="">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <WrapPanel Margin="0,6,0,0">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWeatherData}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>

                            <TextBlock Text="{Binding WeatherTemperatureText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="·" Margin="7,0" FontSize="15"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding WeatherConditionText}" FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="·" Margin="7,0" FontSize="15"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding WeatherWindText}" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: device + effects -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFE81123"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                <Setter Property="Fill" Value="#FF4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="15" TextWrapping="Wrap"
                                       ToolTip="{Binding DriverErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriverErrorText}" Value="">
                                                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L_Driver}" Style="{StaticResource SectionLabelStyle}" Margin="0,14,0,8"/>
                        <ComboBox SelectedIndex="{Binding DriverType}">
                            <ComboBoxItem Content="{DynamicResource L_DriverAuto}"/>
                            <ComboBoxItem Content="{DynamicResource L_DriverInsyde}"/>
                            <ComboBoxItem Content="{DynamicResource L_DriverWmi}"/>
                        </ComboBox>

                        <DockPanel Margin="0,14,0,2">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="15"
                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Brightness, StringFormat={}{0:F0}%}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAsleep}" Value="True">
                                                <Setter Property="Text" Value="0%"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource L_Brightness}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}"
                                IsSnapToTickEnabled="True" TickFrequency="1">
                            <Slider.Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAsleep}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>

                        <ComboBox ItemsSource="{Binding ZoneOptions}" SelectedValuePath="Zone"
                                  SelectedValue="{Binding SelectedZone}" Margin="0,14,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiZoneCapable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource L_ZoneHint}" FontSize="13.5" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>

                        <CheckBox Content="{DynamicResource L_SleepTimer}" IsChecked="{Binding SleepTimerEnabled}"
                                  Margin="0,12,0,0"/>

                        <CheckBox Content="{DynamicResource L_TypingFlash}" IsChecked="{Binding TypingFlashEnabled}"
                                  Margin="0,10,0,0"/>

                        <CheckBox Content="{DynamicResource L_NotificationFlash}"
                                  IsChecked="{Binding NotificationFlashEnabled}" Margin="0,8,0,0"/>

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationFlashEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="15"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="{Binding NotificationFlashSeconds, StringFormat={}{0:F1}}"/>
                                <TextBlock Text="{DynamicResource L_FlashDuration}" FontSize="14"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </DockPanel>

                            <Slider Minimum="0.5" Maximum="5" Value="{Binding NotificationFlashSeconds}"
                                    IsSnapToTickEnabled="True" TickFrequency="0.1" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Whether Windows really starts the app at logon, with a way back -->
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,14,0,10"/>

                        <TextBlock Text="{DynamicResource L_StartupTask}" Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource L_StartupTaskFix}"
                                    Command="{Binding FixStartupTaskCommand}" Height="28" Padding="14,0"
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsStartupTaskFix}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FFE0574C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartupTaskRegistered}" Value="True">
                                                    <Setter Property="Fill" Value="#FF4ADE80"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="{Binding StartupTaskStatus}" FontSize="13.5" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource L_AnimModes}" Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,0,0,4"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}"
                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="170"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource AnimationCardStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="14" Opacity="0.9"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,8,4,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnimationRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="152"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L_AnimSpeed}" Style="{StaticResource ValueLabelStyle}"
                                           FontSize="15" Margin="0,0,8,0"/>
                                <Slider Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="{Binding AnimationSpeed}"
                                        IsSnapToTickEnabled="True" TickFrequency="0.1"/>
                                <TextBlock Grid.Column="2" Text="{Binding AnimationSpeed, StringFormat={}{0:F1}x}"
                                           Style="{StaticResource ValueLabelStyle}" HorizontalAlignment="Right" FontSize="15"/>
                            </Grid>

                            <Button Command="{Binding ToggleAnimationCommand}" Height="46" IsEnabled="{Binding IsReady}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                        <Setter Property="Content" Value="{DynamicResource L_Start}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAnimationRunning}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource L_Stop}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Click="AboutClick" Style="{StaticResource SubtleButtonStyle}" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L_About}" FontSize="15" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LogsButton" Click="LogsClick" Margin="8,0,0,0"
                        Style="{StaticResource SubtleButtonStyle}" Padding="10,4"
                        ToolTip="{DynamicResource L_LogsTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L_Logs}" FontSize="15" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
