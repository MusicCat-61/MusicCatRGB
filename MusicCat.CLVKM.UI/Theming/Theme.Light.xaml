<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Frost — light -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF7A7A7A"/>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#0F000000"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1A7AD0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF00579F"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="TrackBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFF7F7F7"/>

</ResourceDictionary>
