<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Frost — dark -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1F1F1F"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7AFFFFFF"/>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1CFFFFFF"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#18FFFFFF"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6FD0FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3AA9E0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF04222E"/>

    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF202020"/>

</ResourceDictionary>
